# Required: DeepSeek API key
DEEPSEEK_API_KEY=sk-...

# Optional: Moonshot API key
MOONSHOT_API_KEY=sk-...

# Optional: GitHub token for repo access
GH_TOKEN=ghp_...

# Optional: Gitea token for repo access
GITEA_TOKEN=...

# Optional: Gitea server URL (defaults to https://gitea.com)
GITEA_SERVER_URL=https://git.example.com

# Required: Password for opencode server access
OPENCODE_SERVER_PASSWORD=...

# Required: Domain for this service (e.g., opencode.example.com)
DOMAIN=opencode.example.com
